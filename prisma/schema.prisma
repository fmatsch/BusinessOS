generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────── Plattform ─────────

model Tenant {
  id            String         @id @default(cuid())
  name          String
  createdAt     DateTime       @default(now())
  organizations Organization[]
}

model Organization {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  currency  String   @default("EUR")
  timeZone  String   @default("Europe/Vienna")
  locale    String   @default("de")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships      OrganizationMembership[]
  roles            Role[]
  departments      Department[]
  costCenters      CostCenter[]
  suppliers        Supplier[]
  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]
  budgets          Budget[]
  approvals        Approval[]
  sequences        Sequence[]
  approvalPolicies ApprovalPolicy[]
  employees        Employee[]
  absenceTypes     AbsenceType[]
  absenceRequests  AbsenceRequest[]
  auditLogs        AuditLog[]
  outbox           OutboxEvent[]
  notifications    Notification[]
  sites            Site[]

  @@index([tenantId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  locale       String   @default("de")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  memberships OrganizationMembership[]
}

model OrganizationMembership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roleId         String
  role           Role         @relation(fields: [roleId], references: [id])
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Role {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  name           String
  system         Boolean      @default(false)

  permissions RolePermission[]
  memberships OrganizationMembership[]

  @@unique([organizationId, key])
}

model Permission {
  id  String @id @default(cuid())
  key String @unique // modul.ressource.aktion

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  actorUserId    String?
  actorType      String       @default("USER") // USER | AI | SYSTEM
  action         String
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
}

model OutboxEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  type           String
  payload        Json
  attempts       Int          @default(0)
  processedAt    DateTime?
  /// frühester nächster Versuch (exponentielles Backoff)
  nextAttemptAt  DateTime     @default(now())
  lastError      String?
  /// gesetzt, wenn die maximale Zahl Versuche erschöpft ist (Dead Letter)
  failedAt       DateTime?
  createdAt      DateTime     @default(now())

  @@index([processedAt, failedAt, nextAttemptAt])
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  title          String
  body           String?
  type           String       @default("info")
  href           String?
  readAt         DateTime?
  /// verhindert Doppelzustellung bei Wiederholung eines Events
  dedupeKey      String?      @unique
  createdAt      DateTime     @default(now())

  @@index([organizationId, userId, readAt])
}

// ───────── Stammdaten ─────────

model Department {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  parentId       String?
  parent         Department?  @relation("DeptTree", fields: [parentId], references: [id])
  children       Department[] @relation("DeptTree")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  costCenters CostCenter[]
  employees   Employee[]

  @@unique([organizationId, code])
}

model CostCenter {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id])
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  budgets        Budget[]
  purchaseOrders PurchaseOrder[]
  requests       PurchaseRequest[]
  employments    Employment[]

  @@unique([organizationId, code])
}

model Supplier {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number           String
  name             String
  email            String?
  /// UID-Nummer (für den Export an die Steuerberatung)
  uid              String?
  /// Kreditorenkonto (Personenkonto) und Standard-Aufwandskonto
  payableAccountId String?
  expenseAccountId String?
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now())

  purchaseOrders PurchaseOrder[]
  invoices       SupplierInvoice[]

  @@unique([organizationId, number])
}

// ───────── Beschaffung & Budget (Phase 3, Schema vorbereitet) ─────────

enum PurchaseRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ORDERED
}

model PurchaseRequest {
  id             String                @id @default(cuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         String
  title          String
  requesterId    String
  costCenterId   String?
  costCenter     CostCenter?           @relation(fields: [costCenterId], references: [id])
  status         PurchaseRequestStatus @default(DRAFT)
  currency       String                @default("EUR")
  totalAmount    Decimal               @db.Decimal(19, 4)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  submittedAt   DateTime?
  /// Version der Freigaberegel, die beim Einreichen galt (unveränderlich)
  policyVersion Int?
  lines         PurchaseRequestLine[]
  orders        PurchaseOrder[]
  approvals     Approval[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
}

model PurchaseRequestLine {
  id          String          @id @default(cuid())
  requestId   String
  request     PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal         @db.Decimal(19, 4)
  unitPrice   Decimal         @db.Decimal(19, 4)
}

model PurchaseOrder {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         String
  requestId      String?
  request        PurchaseRequest? @relation(fields: [requestId], references: [id])
  supplierId     String
  supplier       Supplier         @relation(fields: [supplierId], references: [id])
  costCenterId   String
  costCenter     CostCenter       @relation(fields: [costCenterId], references: [id])
  currency       String           @default("EUR")
  totalAmount    Decimal          @db.Decimal(19, 4)
  status         String           @default("OPEN")
  createdAt      DateTime         @default(now())

  receipts GoodsReceipt[]

  @@unique([organizationId, number])
  @@index([organizationId, costCenterId])
}

/// Wareneingang zu einer Bestellung (append-only; Korrektur = Gegenbuchung mit reversesId)
model GoodsReceipt {
  id             String             @id @default(cuid())
  organizationId String
  orderId        String
  order          PurchaseOrder      @relation(fields: [orderId], references: [id])
  receivedOn     DateTime           @db.Date
  note           String?
  reversesId     String?            @unique
  createdById    String
  createdAt      DateTime           @default(now())
  lines          GoodsReceiptLine[]

  @@index([organizationId, orderId])
}

model GoodsReceiptLine {
  id            String       @id @default(cuid())
  receiptId     String
  receipt       GoodsReceipt @relation(fields: [receiptId], references: [id])
  requestLineId String
  /// Menge; in Gegenbuchungen negativ
  quantity      Decimal      @db.Decimal(19, 4)

  @@index([receiptId])
  @@index([requestLineId])
}

model Budget {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  costCenterId   String
  costCenter     CostCenter   @relation(fields: [costCenterId], references: [id])
  fiscalYear     Int
  amount         Decimal      @db.Decimal(19, 4)
  currency       String       @default("EUR")

  @@unique([costCenterId, fiscalYear])
  @@index([organizationId])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Approval {
  id                 String           @id @default(cuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// genau eines von requestId / absenceRequestId / quoteId ist gesetzt (CHECK-Constraint in der Migration)
  requestId          String?
  request            PurchaseRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  absenceRequestId   String?
  absenceRequest     AbsenceRequest?  @relation(fields: [absenceRequestId], references: [id], onDelete: Cascade)
  quoteId            String?
  quote              Quote?           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  expenseReportId    String?
  expenseReport      ExpenseReport?   @relation(fields: [expenseReportId], references: [id], onDelete: Cascade)
  stepKey            String
  label              String           @default("")
  /// Schnappschuss der nötigen Berechtigung aus der Freigaberegel
  requiredPermission String
  sequence           Int
  status             ApprovalStatus   @default(PENDING)
  decidedById        String?
  decidedAt          DateTime?
  comment            String?

  @@unique([requestId, sequence])
  @@unique([absenceRequestId, sequence])
  @@unique([quoteId, sequence])
  @@unique([expenseReportId, sequence])
  @@index([organizationId, status])
}

/// Atomare Nummernkreise pro Organisation (z. B. PR-2026, PO-2026)
model Sequence {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  value          Int          @default(0)

  @@id([organizationId, key])
}

/// Versionierte Freigaberegel je Objektart. Neue Version = neue Zeile; laufende Vorgänge behalten ihre Version.
model ApprovalPolicy {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subjectType    String // z. B. PURCHASE_REQUEST
  version        Int
  steps          Json // [{ key, label, permission, minAmount? }]
  createdById    String?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, subjectType, version])
}

// ───────── HR-Basis (M7) ─────────

model Employee {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         String
  firstName      String
  lastName       String
  email          String?
  jobTitle       String?
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id])
  /// direkte Führungskraft (für Team-Sichtbarkeit und Abwesenheitsfreigabe)
  managerId      String?
  manager        Employee?    @relation("EmployeeManager", fields: [managerId], references: [id])
  reports        Employee[]   @relation("EmployeeManager")
  /// optionale Verknüpfung zum Benutzerkonto
  userId         String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  sensitive    EmployeeSensitive?
  employments  Employment[]
  absences     AbsenceRequest[]
  leaveEntries LeaveBalanceEntry[]

  @@unique([organizationId, number])
  @@unique([organizationId, userId])
  @@index([organizationId, managerId])
}

/// Getrennt gespeicherte, besonders schützenswerte Angaben (eigene Berechtigung, Zugriffe werden protokolliert)
model EmployeeSensitive {
  employeeId       String    @id
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organizationId   String
  birthDate        DateTime? @db.Date
  addressLine      String?
  phone            String?
  emergencyContact String?
  updatedAt        DateTime  @updatedAt
}

model Employment {
  id             String      @id @default(cuid())
  organizationId String
  employeeId     String
  employee       Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  validFrom      DateTime    @db.Date
  validTo        DateTime?   @db.Date
  contractType   String // FULL_TIME | PART_TIME | MARGINAL | APPRENTICE | OTHER
  weeklyHours    Decimal     @db.Decimal(5, 2)
  costCenterId   String?
  costCenter     CostCenter? @relation(fields: [costCenterId], references: [id])
  createdAt      DateTime    @default(now())

  @@index([organizationId, employeeId, validFrom])
}

model AbsenceType {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key              String
  name             String
  /// zieht vom Urlaubskonto ab
  deductsLeave     Boolean      @default(false)
  requiresApproval Boolean      @default(true)

  requests AbsenceRequest[]

  @@unique([organizationId, key])
}

enum AbsenceStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model AbsenceRequest {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  typeId         String
  type           AbsenceType   @relation(fields: [typeId], references: [id])
  startDate      DateTime      @db.Date
  endDate        DateTime      @db.Date
  /// Arbeitstage (Mo–Fr ohne gesetzliche Feiertage), beim Antrag berechnet
  days           Decimal       @db.Decimal(6, 2)
  status         AbsenceStatus @default(PENDING)
  /// bewusst nur ein freier Hinweis – bei Krankheit keine Diagnosen erfassen
  note           String?
  policyVersion  Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  approvals    Approval[]
  leaveEntries LeaveBalanceEntry[]

  @@index([organizationId, status])
  @@index([organizationId, employeeId, startDate])
}

/// Urlaubskonto als Journal: append-only (DB-Trigger verbietet UPDATE/DELETE). Saldo = Summe der Einträge je Jahr.
model LeaveBalanceEntry {
  id               String          @id @default(cuid())
  organizationId   String
  employeeId       String
  employee         Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year             Int
  /// ENTITLEMENT | CARRYOVER | ADJUSTMENT | TAKEN | REVERSAL
  kind             String
  /// vorzeichenbehaftet: Anspruch +, Verbrauch −
  days             Decimal         @db.Decimal(6, 2)
  absenceRequestId String?
  absenceRequest   AbsenceRequest? @relation(fields: [absenceRequestId], references: [id])
  note             String?
  createdById      String?
  createdAt        DateTime        @default(now())

  @@index([organizationId, employeeId, year])
}

// ───────── Dienstplanung (M8) ─────────

model Site {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  /// IANA-Zeitzone des Standorts (Schichtzeiten sind Ortszeit)
  timeZone       String       @default("Europe/Vienna")
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())

  rosters Roster[]

  @@unique([organizationId, name])
}

model Qualification {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  employees EmployeeQualification[]
  templates ShiftTemplate[]
  shifts    Shift[]

  @@unique([organizationId, name])
}

model EmployeeQualification {
  employeeId      String
  qualificationId String
  qualification   Qualification @relation(fields: [qualificationId], references: [id], onDelete: Cascade)
  organizationId  String

  @@id([employeeId, qualificationId])
}

model ShiftTemplate {
  id              String         @id @default(cuid())
  organizationId  String
  name            String
  /// Ortszeit HH:MM; Ende vor Beginn = Schicht über Mitternacht
  startTime       String
  endTime         String
  breakMinutes    Int            @default(0)
  requiredCount   Int            @default(1)
  qualificationId String?
  qualification   Qualification? @relation(fields: [qualificationId], references: [id])

  @@unique([organizationId, name])
}

model Roster {
  id               String   @id @default(cuid())
  organizationId   String
  siteId           String
  site             Site     @relation(fields: [siteId], references: [id])
  startDate        DateTime @db.Date
  endDate          DateTime @db.Date
  /// zuletzt veröffentlichte Version (0 = noch nie veröffentlicht)
  publishedVersion Int      @default(0)
  /// Arbeitskopie weicht von der veröffentlichten Version ab
  dirty            Boolean  @default(true)
  createdAt        DateTime @default(now())

  shifts   Shift[]
  versions RosterVersion[]
  swaps    ShiftSwapRequest[]

  @@index([organizationId, siteId, startDate])
}

model Shift {
  id              String         @id @default(cuid())
  organizationId  String
  rosterId        String
  roster          Roster         @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  /// Ortsdatum des Schichtbeginns
  localDate       DateTime       @db.Date
  startAt         DateTime
  endAt           DateTime
  breakMinutes    Int            @default(0)
  requiredCount   Int            @default(1)
  qualificationId String?
  qualification   Qualification? @relation(fields: [qualificationId], references: [id])
  label           String?

  assignments ShiftAssignment[]
  swaps       ShiftSwapRequest[]

  @@index([organizationId, rosterId, startAt])
}

model ShiftAssignment {
  id             String   @id @default(cuid())
  organizationId String
  shiftId        String
  shift          Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  employeeId     String
  createdAt      DateTime @default(now())

  @@unique([shiftId, employeeId])
  @@index([organizationId, employeeId])
}

/// Unveränderliche Momentaufnahme eines veröffentlichten Plans (DB-Trigger verbietet UPDATE/DELETE)
model RosterVersion {
  id             String   @id @default(cuid())
  organizationId String
  rosterId       String
  roster         Roster   @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  version        Int
  snapshot       Json
  /// { added: [...], removed: [...], reason }
  changes        Json
  publishedById  String
  publishedAt    DateTime @default(now())

  @@unique([rosterId, version])
}

/// Aktueller veröffentlichter Stand je Person (Projektion der jüngsten Version, wird bei Veröffentlichung ersetzt)
model PublishedShift {
  id             String   @id @default(cuid())
  organizationId String
  rosterId       String
  version        Int
  shiftId        String
  employeeId     String
  startAt        DateTime
  endAt          DateTime
  breakMinutes   Int
  siteName       String
  label          String?

  @@index([organizationId, employeeId, startAt])
  @@index([rosterId])
}

enum SwapStatus {
  PENDING_PEER
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

model ShiftSwapRequest {
  id             String     @id @default(cuid())
  organizationId String
  rosterId       String
  roster         Roster     @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  shiftId        String
  shift          Shift      @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  fromEmployeeId String
  toEmployeeId   String
  status         SwapStatus @default(PENDING_PEER)
  note           String?
  decidedById    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([organizationId, status])
}

model RosterRules {
  organizationId    String @id
  /// Mindest-Tagesruhezeit zwischen zwei Schichten (Minuten)
  restDailyMinutes  Int    @default(660)
  /// Höchstarbeitszeit je Tag (Minuten, nach Pausenabzug)
  maxDailyMinutes   Int    @default(720)
  /// Höchstarbeitszeit je Woche (Minuten)
  maxWeeklyMinutes  Int    @default(3600)
  /// ab dieser Schichtlänge ist eine Pause nötig (Minuten)
  breakAfterMinutes Int    @default(360)
  minBreakMinutes   Int    @default(30)
  /// zusammenhängende Wochenruhe (Minuten)
  weeklyRestMinutes Int    @default(2160)
}

// ───────── Zeiterfassung (M9) ─────────

/// Laufende Stempelung (flüchtiger Zustand, wird beim Ausstempeln zu einem unveränderlichen TimeEntry)
model TimeClock {
  employeeId     String    @id
  organizationId String
  startedAt      DateTime
  costCenterId   String?
  breakStartedAt DateTime?
  breakMinutes   Int       @default(0)
}

/// Unveränderlicher Zeitbuchungs-Journal (DB-Trigger verbietet UPDATE/DELETE). Korrektur = REVERSAL + neue WORK-Buchung.
model TimeEntry {
  id             String     @id @default(cuid())
  organizationId String
  employeeId     String
  /// WORK | REVERSAL
  kind           String
  startAt        DateTime
  endAt          DateTime
  breakMinutes   Int        @default(0)
  /// Ortsdatum des Beginns in der Organisationszeitzone (für Periodenzuordnung)
  localDate      DateTime   @db.Date
  costCenterId   String?
  /// CLOCK | MANUAL | CORRECTION | REVERSAL
  source         String
  reason         String?
  /// bei Korrektur: die ersetzte Buchung
  replacesId     String?
  reversesId     String?    @unique
  reverses       TimeEntry? @relation("TimeEntryReversal", fields: [reversesId], references: [id])
  reversedBy     TimeEntry? @relation("TimeEntryReversal")
  createdById    String
  createdAt      DateTime   @default(now())

  @@index([organizationId, employeeId, startAt])
}

enum TimeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Antrag auf nachträgliche Erfassung, Korrektur oder Stornierung einer Buchung (mit Begründung und Freigabe)
model TimeEntryRequest {
  id             String            @id @default(cuid())
  organizationId String
  employeeId     String
  /// ADD | CORRECT | DELETE
  type           String
  targetEntryId  String?
  startAt        DateTime?
  endAt          DateTime?
  breakMinutes   Int?
  costCenterId   String?
  reason         String
  status         TimeRequestStatus @default(PENDING)
  decidedById    String?
  decidedAt      DateTime?
  comment        String?
  createdAt      DateTime          @default(now())

  @@index([organizationId, status])
  @@index([organizationId, employeeId])
}

enum PeriodStatus {
  OPEN
  SUBMITTED
  APPROVED
}

/// Monatsabschluss je Mitarbeiter: eingereicht → freigegeben (gesperrt) → ggf. mit Begründung wieder geöffnet
model TimesheetPeriod {
  id             String       @id @default(cuid())
  organizationId String
  employeeId     String
  year           Int
  month          Int
  status         PeriodStatus @default(OPEN)
  submittedAt    DateTime?
  approvedById   String?
  approvedAt     DateTime?
  /// Ergebnis zum Zeitpunkt der Freigabe (Ist, Soll, Saldo, Kategorien)
  summary        Json?
  reopenCount    Int          @default(0)

  @@unique([organizationId, employeeId, year, month])
}

/// Zeitkonto (Überstunden-/Gleitzeitsaldo) als Journal, append-only: Saldo = Summe der Minuten
model TimeAccountEntry {
  id             String   @id @default(cuid())
  organizationId String
  employeeId     String
  /// PERIOD | REVERSAL | ADJUSTMENT
  kind           String
  minutes        Int
  periodId       String?
  year           Int?
  month          Int?
  note           String?
  createdById    String
  createdAt      DateTime @default(now())

  @@index([organizationId, employeeId])
}

/// Zuschlagsregeln (Prozentsätze sind Konfiguration, kein Rechtsrat; die Auszahlung folgt mit dem Lohn-Export)
model PayCodeRule {
  organizationId String
  /// NIGHT | SUNDAY | HOLIDAY | OVERTIME
  kind           String
  percent        Decimal @db.Decimal(6, 2)

  @@id([organizationId, kind])
}

// ───────── Lohn-Export (M10) ─────────

/// Ausgabeprofil für den Lohn-Export (Format und Lohnart-Zuordnung). Keine Lohnberechnung.
model PayrollProfile {
  organizationId   String   @id
  delimiter        String   @default(";")
  decimalSeparator String   @default(",")
  includeHeader    Boolean  @default(true)
  /// utf8 | utf8-bom | latin1
  encoding         String   @default("utf8-bom")
  /// HOURS (Dezimalstunden) | MINUTES
  unit             String   @default("HOURS")
  includeSurcharge Boolean  @default(true)
  /// { NORMAL, MEHRZEIT, NIGHT, SUNDAY, HOLIDAY, VACATION, SICK, CARE, SPECIAL } -> Lohnart-Nummer des Zielsystems
  codes            Json     @default("{}")
  updatedAt        DateTime @updatedAt
}

/// Ein Exportlauf für einen Monat. Unveränderlich (Trigger). Spätere Änderungen erscheinen als weiterer Lauf („Nachtrag") mit den Differenzen.
model PayrollExport {
  id             String   @id @default(cuid())
  organizationId String
  year           Int
  month          Int
  /// laufende Nummer je Monat: 1 = Erstexport, ab 2 = Nachtrag
  version        Int
  fileName       String
  /// vollständiger Dateiinhalt als Text (vor der Zeichensatz-Umwandlung)
  content        String
  /// SHA-256 der ausgelieferten Bytes
  contentHash    String
  profile        Json
  /// Hinweise der Plausibilitätsprüfung zum Zeitpunkt des Exports
  checks         Json
  /// Beschäftigte, die bewusst noch nicht enthalten waren
  excluded       Json
  lineCount      Int
  createdById    String
  createdAt      DateTime @default(now())

  lines PayrollExportLine[]

  @@unique([organizationId, year, month, version])
}

model PayrollExportLine {
  id             String        @id @default(cuid())
  organizationId String
  exportId       String
  export         PayrollExport @relation(fields: [exportId], references: [id], onDelete: Cascade)
  employeeId     String
  employeeNumber String
  /// NORMAL | MEHRZEIT | NIGHT | SUNDAY | HOLIDAY | VACATION | SICK | CARE | SPECIAL
  wageType       String
  /// Minuten (bei Abwesenheiten: Tage); in Nachträgen vorzeichenbehaftete Differenz
  quantity       Int
  unit           String
  percent        Decimal?      @db.Decimal(6, 2)

  @@index([organizationId, employeeId])
  @@index([exportId])
}

// ───────── Finanzen: Belege und Export an die Steuerberatung (M12, Variante B) ─────────
// Die Steuerberatung führt die Bücher; hier entstehen Belege mit Kontierung und der Export (DATEV, BMD).

model Account {
  id             String   @id @default(cuid())
  organizationId String
  number         String
  name           String
  /// GL = Sachkonto | VENDOR = Kreditor | CUSTOMER = Debitor
  type           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@unique([organizationId, number])
}

model TaxCode {
  id             String  @id @default(cuid())
  organizationId String
  key            String
  name           String
  rate           Decimal @db.Decimal(5, 2)
  /// INPUT = Vorsteuer | OUTPUT = Umsatzsteuer
  direction      String
  /// Steuercode im BMD-Format (BuErf: z. B. 1 = Umsatzsteuer, 2 = Vorsteuer)
  bmdCode        String?
  /// BU-Schlüssel im DATEV-Format laut Vorgabe der Steuerberatung
  datevKey       String?
  active         Boolean @default(true)

  @@unique([organizationId, key])
}

model Customer {
  id                  String   @id @default(cuid())
  organizationId      String
  number              String
  name                String
  street              String?
  zip                 String?
  city                String?
  country             String   @default("AT")
  uid                 String?
  paymentTermsDays    Int      @default(14)
  receivableAccountId String?
  revenueAccountId    String?
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())

  invoices   CustomerInvoice[]
  recurring  RecurringInvoice[]
  contacts   Contact[]
  activities Activity[]
  quotes     Quote[]

  @@unique([organizationId, number])
}

/// Belegdatei (Rechnung als PDF/Bild), geprüft nach Typ und Größe, mit SHA-256
model FinanceFile {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  mime           String
  size           Int
  sha256         String
  data           Bytes
  uploadedById   String
  createdAt      DateTime @default(now())
}

model SupplierInvoice {
  id                   String    @id @default(cuid())
  organizationId       String
  supplierId           String
  supplier             Supplier  @relation(fields: [supplierId], references: [id])
  /// Rechnungsnummer des Lieferanten (je Lieferant eindeutig, solange nicht storniert; Teil-Index in der Migration)
  invoiceNumber        String
  invoiceDate          DateTime  @db.Date
  dueDate              DateTime? @db.Date
  /// INVOICE | CREDIT (Gutschrift; Beträge positiv, das Vorzeichen ergibt sich aus der Art)
  kind                 String    @default("INVOICE")
  creditsId            String?
  /// DRAFT | APPROVED | CANCELLED
  status               String    @default("DRAFT")
  /// interne Belegnummer, vergeben bei der Freigabe (ER-2027-0001)
  voucherNumber        String?
  currency             String    @default("EUR")
  netTotal             Decimal   @db.Decimal(19, 4)
  taxTotal             Decimal   @db.Decimal(19, 4)
  grossTotal           Decimal   @db.Decimal(19, 4)
  purchaseOrderId      String?
  fileId               String?
  paidOn               DateTime? @db.Date
  note                 String?
  createdById          String
  approvedById         String?
  approvedAt           DateTime?
  /// Abweichung vom Abgleich mit Bestellung und Wareneingang wurde ausdrücklich akzeptiert
  varianceAcceptedById String?
  varianceAcceptedAt   DateTime?
  varianceReason       String?
  createdAt            DateTime  @default(now())

  lines SupplierInvoiceLine[]

  @@unique([organizationId, voucherNumber])
  @@index([organizationId, status])
}

model SupplierInvoiceLine {
  id               String          @id @default(cuid())
  invoiceId        String
  invoice          SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description      String
  netAmount        Decimal         @db.Decimal(19, 4)
  taxCodeId        String
  expenseAccountId String
  costCenterId     String?
}

// ───────── Workflows: versionierte Regeln (Ereignis → Bedingungen → Benachrichtigung) ─────────

/// Eine Version einer Workflow-Regel. Veröffentlichte Versionen werden nie geändert; es gilt die höchste Version je Schlüssel.
model WorkflowDefinition {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  version        Int
  name           String
  eventType      String
  /// [{ field, op, value }] – alle müssen zutreffen
  conditions     Json
  /// [{ type: "NOTIFY", recipient, title, body? }]
  actions        Json
  enabled        Boolean  @default(true)
  createdById    String
  createdAt      DateTime @default(now())

  runs WorkflowRun[]

  @@unique([organizationId, key, version])
  @@index([organizationId, eventType])
}

/// Protokoll: welches Ereignis hat welche Regelversion ausgelöst. Je Regelversion und Ereignis höchstens ein Eintrag (Idempotenz).
model WorkflowRun {
  id              String             @id @default(cuid())
  organizationId  String
  definitionId    String
  definition      WorkflowDefinition @relation(fields: [definitionId], references: [id])
  eventId         String
  eventType       String
  /// Bedingungen erfüllt und Aktionen ausgeführt?
  matched         Boolean
  notifications   Int                @default(0)
  createdAt       DateTime           @default(now())

  @@unique([definitionId, eventId])
  @@index([organizationId, createdAt])
}

// ───────── KI-Copilot: Vorschläge mit Bestätigung ─────────

/// Änderung, die der Copilot vorschlägt. Ausgeführt wird sie nur, wenn dieselbe Person sie bestätigt – mit deren Berechtigungen.
model CopilotProposal {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  tool           String
  /// geprüfte Eingabe des Werkzeugs
  input          Json
  /// vom Server aus der geprüften Eingabe gebildete Beschreibung (nicht vom Modell)
  summary        String
  /// PENDING | EXECUTED | FAILED | REJECTED | EXPIRED
  status         String    @default("PENDING")
  resultMessage  String?
  createdAt      DateTime  @default(now())
  decidedAt      DateTime?

  @@index([organizationId, userId, status])
}

// ───────── Lager: Artikel und Bestandsbewegungen ─────────

/// Artikel. Ein Lager je Organisation (keine Lagerorte).
model Item {
  id             String   @id @default(cuid())
  organizationId String
  number         String
  name           String
  unit           String   @default("Stk")
  /// Mindestbestand für den Hinweis „nachbestellen“
  reorderLevel   Decimal? @db.Decimal(19, 4)
  active         Boolean  @default(true)
  createdById    String
  createdAt      DateTime @default(now())

  movements StockMovement[]

  @@unique([organizationId, number])
}

/// Bestandsbewegung (Menge mit Vorzeichen). Journal: unveränderlich (Trigger), Korrektur per Gegenbuchung. Bestand = Summe.
model StockMovement {
  id                 String         @id @default(cuid())
  organizationId     String
  itemId             String
  item               Item           @relation(fields: [itemId], references: [id])
  /// RECEIPT (Wareneingang) | ISSUE (Entnahme) | ADJUST (Inventurkorrektur) | REVERSAL (Gegenbuchung)
  kind               String
  quantity           Decimal        @db.Decimal(19, 4)
  costCenterId       String?
  /// jede Wareneingangsposition wird höchstens einmal eingebucht
  goodsReceiptLineId String?        @unique
  reversesId         String?        @unique
  reverses           StockMovement? @relation("StockMovementReversal", fields: [reversesId], references: [id])
  reversedBy         StockMovement? @relation("StockMovementReversal")
  note               String?
  createdById        String
  createdAt          DateTime       @default(now())

  @@index([organizationId, itemId, createdAt])
}

// ───────── Reisekosten und Spesen ─────────

/// Einstellungen der Spesenabrechnung je Organisation (z. B. Kilometergeld je km)
model ExpenseSettings {
  organizationId String  @id
  mileageRate    Decimal @default(0.50) @db.Decimal(9, 4)
}

/// Spesenabrechnung einer Person. DRAFT → SUBMITTED (Freigabe laut Regel) → APPROVED → PAID; REJECTED/CANCELLED enden.
model ExpenseReport {
  id             String    @id @default(cuid())
  organizationId String
  employeeId     String
  /// EX-2027-0001, vergeben beim Einreichen
  number         String?
  title          String
  tripFrom       DateTime? @db.Date
  tripTo         DateTime? @db.Date
  costCenterId   String?
  status         String    @default("DRAFT")
  currency       String    @default("EUR")
  /// Summe der Positionen (brutto, wie ausgelegt)
  totalAmount    Decimal   @default(0) @db.Decimal(19, 4)
  policyVersion  Int?
  note           String?
  submittedAt    DateTime?
  decidedAt      DateTime?
  paidOn         DateTime? @db.Date
  paidById       String?
  createdAt      DateTime  @default(now())

  lines     ExpenseLine[]
  approvals Approval[]

  @@unique([organizationId, number])
  @@index([organizationId, employeeId])
  @@index([organizationId, status])
}

model ExpenseLine {
  id            String        @id @default(cuid())
  reportId      String
  report        ExpenseReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  date          DateTime      @db.Date
  /// TRAVEL | ACCOMMODATION | MEALS | MILEAGE | OTHER
  category      String
  description   String
  /// bei Kilometergeld: gefahrene km
  quantity      Decimal?      @db.Decimal(9, 2)
  amount        Decimal       @db.Decimal(19, 4)
  receiptFileId String?
}

// ───────── Bankabgleich ─────────

/// Importierter Kontoauszug (CAMT.053 oder CSV). Dieselbe Datei wird nicht zweimal importiert.
model BankImport {
  id             String   @id @default(cuid())
  organizationId String
  filename       String
  /// CAMT | CSV
  format         String
  sha256         String
  lineCount      Int
  newCount       Int
  createdById    String
  createdAt      DateTime @default(now())

  lines BankLine[]

  @@unique([organizationId, sha256])
}

/// Eine Zahlung aus dem Kontoauszug (Betrag mit Vorzeichen: Eingang +, Ausgang −). Nur der Zuordnungsstatus ändert sich.
model BankLine {
  id               String     @id @default(cuid())
  organizationId   String
  importId         String
  import           BankImport @relation(fields: [importId], references: [id])
  bookingDate      DateTime   @db.Date
  amount           Decimal    @db.Decimal(19, 4)
  currency         String     @default("EUR")
  counterpartyName String?
  counterpartyIban String?
  reference        String     @default("")
  endToEndId       String?
  /// stabiler Schlüssel gegen doppelte Importe überlappender Auszüge
  dedupeKey        String
  /// OPEN | MATCHED | IGNORED
  status           String     @default("OPEN")
  /// CUSTOMER_INVOICE | SUPPLIER_INVOICE
  matchKind        String?
  matchedId        String?
  decidedById      String?
  decidedAt        DateTime?
  note             String?
  createdAt        DateTime   @default(now())

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, status, bookingDate])
}

// ───────── Projekte: Leistungserfassung und Abrechnung nach Stunden ─────────

/// Projekt. Die Projektstunden sind eine eigene Leistungserfassung (unabhängig von der Arbeitszeiterfassung).
model Project {
  id             String    @id @default(cuid())
  organizationId String
  /// lückenlose Projektnummer (PJ-2027-0001)
  number         String
  name           String
  customerId     String?
  costCenterId   String?
  /// ACTIVE | CLOSED
  status         String    @default("ACTIVE")
  /// Verrechnungssatz je Stunde (netto)
  hourlyRate     Decimal?  @db.Decimal(19, 2)
  budgetHours    Decimal?  @db.Decimal(9, 2)
  startsOn       DateTime? @db.Date
  endsOn         DateTime? @db.Date
  note           String?
  createdById    String
  createdAt      DateTime  @default(now())

  times    ProjectTime[]
  billings ProjectBilling[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
}

/// Gebuchte Projektzeit. Journal: unveränderlich (Trigger), Korrektur nur per Gegenbuchung (REVERSAL).
model ProjectTime {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id])
  employeeId     String
  workDate       DateTime     @db.Date
  minutes        Int
  note           String?
  /// WORK | REVERSAL
  kind           String
  reversesId     String?      @unique
  reverses       ProjectTime? @relation("ProjectTimeReversal", fields: [reversesId], references: [id])
  reversedBy     ProjectTime? @relation("ProjectTimeReversal")
  createdById    String
  createdAt      DateTime     @default(now())

  billingItem ProjectBillingItem?

  @@index([organizationId, projectId, workDate])
  @@index([organizationId, employeeId, workDate])
}

/// Abrechnungslauf eines Projekts: erzeugt einen Rechnungsentwurf. Unveränderlich (Trigger).
model ProjectBilling {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id])
  invoiceId      String   @unique
  /// letzter Stichtag (inklusive)
  upTo           DateTime @db.Date
  minutes        Int
  hourlyRate     Decimal  @db.Decimal(19, 2)
  netAmount      Decimal  @db.Decimal(19, 4)
  createdById    String
  createdAt      DateTime @default(now())

  items ProjectBillingItem[]

  @@index([organizationId, projectId])
}

/// Jede Projektzeit wird höchstens einmal abgerechnet (eindeutig).
model ProjectBillingItem {
  id        String         @id @default(cuid())
  billingId String
  billing   ProjectBilling @relation(fields: [billingId], references: [id])
  timeId    String         @unique
  time      ProjectTime    @relation(fields: [timeId], references: [id])
}

// ───────── CRM (schlank): Kontakte, Aktivitäten, Angebote ─────────

/// Ansprechperson eines Kunden. Personenbezogen: Löschwunsch per Anonymisierung (Name und Kontaktdaten werden gelöscht, der Datensatz bleibt für Verweise).
model Contact {
  id             String    @id @default(cuid())
  organizationId String
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id])
  name           String
  position       String?
  email          String?
  phone          String?
  note           String?
  active         Boolean   @default(true)
  anonymizedAt   DateTime?
  createdById    String
  createdAt      DateTime  @default(now())

  activities Activity[]

  @@index([organizationId, customerId])
}

/// Aktivitätsprotokoll (Anruf, E-Mail, Termin, Notiz). Unveränderlich (Trigger).
model Activity {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  contactId      String?
  contact        Contact? @relation(fields: [contactId], references: [id])
  /// CALL | MAIL | MEETING | NOTE
  type           String
  occurredOn     DateTime @db.Date
  subject        String
  body           String?
  createdById    String
  createdAt      DateTime @default(now())

  @@index([organizationId, customerId, occurredOn])
}

/// Angebot. DRAFT → PENDING (Freigabe) → APPROVED → SENT (Nummer, eingefroren) → ACCEPTED | DECLINED; DRAFT/PENDING/APPROVED → CANCELLED.
model Quote {
  id             String    @id @default(cuid())
  organizationId String
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id])
  /// lückenlose Angebotsnummer, vergeben beim Versenden (AN-2027-0001)
  number         String?
  title          String
  validUntil     DateTime  @db.Date
  status         String    @default("DRAFT")
  currency       String    @default("EUR")
  netTotal       Decimal   @db.Decimal(19, 4)
  taxTotal       Decimal   @db.Decimal(19, 4)
  grossTotal     Decimal   @db.Decimal(19, 4)
  note           String?
  policyVersion  Int?
  issuerSnapshot Json?
  sentAt         DateTime?
  decidedAt      DateTime?
  decidedById    String?
  /// Rechnungsentwurf, der aus dem angenommenen Angebot entstanden ist
  invoiceId      String?   @unique
  createdById    String
  createdAt      DateTime  @default(now())

  lines     QuoteLine[]
  approvals Approval[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
}

model QuoteLine {
  id               String  @id @default(cuid())
  quoteId          String
  quote            Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description      String
  quantity         Decimal @db.Decimal(19, 4)
  unitPrice        Decimal @db.Decimal(19, 4)
  netAmount        Decimal @db.Decimal(19, 4)
  taxCodeId        String
  revenueAccountId String?
}

/// Vorlage für wiederkehrende Rechnungen. Erzeugt nur Entwürfe; das Ausstellen bleibt eine bewusste Handlung.
model RecurringInvoice {
  id             String    @id @default(cuid())
  organizationId String
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id])
  title          String
  /// MONTHLY | QUARTERLY | YEARLY
  interval       String
  /// Tag des Monats, an dem die Rechnung datiert wird (1–31; kurze Monate nehmen den letzten Tag)
  anchorDay      Int
  nextRunOn      DateTime  @db.Date
  endsOn         DateTime? @db.Date
  active         Boolean   @default(true)
  note           String?
  lastRunOn      DateTime? @db.Date
  createdById    String
  createdAt      DateTime  @default(now())

  lines RecurringInvoiceLine[]

  @@index([organizationId, active, nextRunOn])
}

model RecurringInvoiceLine {
  id               String           @id @default(cuid())
  templateId       String
  template         RecurringInvoice @relation(fields: [templateId], references: [id], onDelete: Cascade)
  description      String
  quantity         Decimal          @db.Decimal(19, 4)
  unitPrice        Decimal          @db.Decimal(19, 4)
  taxCodeId        String
  revenueAccountId String?
  costCenterId     String?
}

model CustomerInvoice {
  id             String    @id @default(cuid())
  organizationId String
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id])
  /// lückenlose Rechnungsnummer, vergeben beim Ausstellen (AR-2027-0001)
  number         String?
  invoiceDate    DateTime  @db.Date
  dueDate        DateTime? @db.Date
  kind           String    @default("INVOICE")
  creditsId      String?
  /// DRAFT | ISSUED | CANCELLED (nur Entwürfe können storniert werden; ausgestellte Rechnungen nur per Gutschrift)
  status         String    @default("DRAFT")
  currency       String    @default("EUR")
  netTotal       Decimal   @db.Decimal(19, 4)
  taxTotal       Decimal   @db.Decimal(19, 4)
  grossTotal     Decimal   @db.Decimal(19, 4)
  paidOn         DateTime? @db.Date
  note           String?
  /// Aussteller-Angaben zum Zeitpunkt des Ausstellens (damit das PDF später unverändert bleibt)
  issuerSnapshot Json?
  /// Herkunft: Vorlage und Rechnungsdatum (verhindert doppelte Läufe)
  recurringId    String?
  recurringDate  DateTime? @db.Date
  createdById    String
  issuedById     String?
  issuedAt       DateTime?
  createdAt      DateTime  @default(now())

  lines CustomerInvoiceLine[]

  @@unique([organizationId, number])
  @@unique([recurringId, recurringDate])
  @@index([organizationId, status])
}

model CustomerInvoiceLine {
  id               String          @id @default(cuid())
  invoiceId        String
  invoice          CustomerInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description      String
  quantity         Decimal         @db.Decimal(19, 4)
  unitPrice        Decimal         @db.Decimal(19, 4)
  netAmount        Decimal         @db.Decimal(19, 4)
  taxCodeId        String
  revenueAccountId String
  costCenterId     String?
}

/// Mahnung zu einer Ausgangsrechnung. Unveränderlich (Trigger): jede Stufe ist ein eigener Eintrag.
model DunningNotice {
  id             String   @id @default(cuid())
  organizationId String
  invoiceId      String
  /// 1 Zahlungserinnerung · 2 erste Mahnung · 3 letzte Mahnung
  level          Int
  issuedOn       DateTime @db.Date
  /// offener Betrag (brutto) zum Zeitpunkt der Mahnung
  openAmount     Decimal  @db.Decimal(19, 4)
  /// manuell eingetragene Gebühr (keine Zinsberechnung)
  feeAmount      Decimal  @default(0) @db.Decimal(19, 4)
  payByDate      DateTime @db.Date
  note           String?
  createdById    String
  createdAt      DateTime @default(now())

  @@unique([organizationId, invoiceId, level])
  @@index([organizationId, invoiceId])
}

model AccountingProfile {
  organizationId       String  @id
  /// DATEV | BMD
  format               String  @default("BMD")
  /// DATEV: Beraternummer und Mandantennummer
  advisorNumber        String?
  clientNumber         String?
  /// Stelligkeit der Sachkonten (DATEV-Kopfzeile, Prüfung bei BMD)
  accountLength        Int     @default(4)
  /// Beginn des Wirtschaftsjahres (Monat)
  fiscalYearStartMonth Int     @default(1)
  /// BMD: Buchungssymbol (Belegkreis, max. 3 Zeichen) für Eingangs- und Ausgangsrechnungen
  symbolIn             String  @default("ER")
  symbolOut            String  @default("AR")
  /// DATEV: Diktatkürzel
  dictationCode        String  @default("")
  includeFiles         Boolean @default(true)
  /// Toleranz beim Rechnungsabgleich: die größere von Prozent der Rechnungssumme und Betrag
  matchTolerancePercent Decimal @default(2) @db.Decimal(5, 2)
  matchToleranceAmount  Decimal @default(5) @db.Decimal(19, 2)
}

/// Aussteller der Ausgangsrechnungen (Briefkopf und Bankverbindung). Beim Ausstellen wird eine Kopie am Beleg gespeichert.
model IssuerProfile {
  organizationId  String  @id
  legalName       String
  street          String?
  zip             String?
  city            String?
  country         String  @default("AT")
  uid             String?
  /// Firmenbuchnummer und -gericht, Rechtsform
  companyRegister String?
  iban            String?
  bic             String?
  bankName        String?
  email           String?
  phone           String?
}

/// Ein Exportlauf an die Steuerberatung. Unveränderlich (Trigger); jeder Beleg wird höchstens einmal exportiert.
model AccountingExport {
  id             String    @id @default(cuid())
  organizationId String
  version        Int
  format         String
  fileName       String
  content        String
  contentHash    String
  packageName    String?
  packageData    Bytes?
  packageHash    String?
  profile        Json
  checks         Json
  voucherCount   Int
  lineCount      Int
  fromDate       DateTime? @db.Date
  toDate         DateTime? @db.Date
  createdById    String
  createdAt      DateTime  @default(now())

  items AccountingExportItem[]

  @@unique([organizationId, version])
}

model AccountingExportItem {
  id             String           @id @default(cuid())
  organizationId String
  exportId       String
  export         AccountingExport @relation(fields: [exportId], references: [id], onDelete: Cascade)
  /// SUPPLIER | CUSTOMER
  voucherType    String
  voucherId      String

  @@unique([organizationId, voucherType, voucherId])
}
