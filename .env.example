# Kopieren nach .env und Werte setzen. .env wird nie committet.
POSTGRES_USER=businessos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=businessos
DATABASE_URL="postgresql://businessos:change-me@localhost:5432/businessos?schema=public"

# Erzeugen mit: npx auth secret   (oder: openssl rand -base64 32)
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Nur für lokales Seeding (synthetische Demo-Daten)
SEED_DEMO_PASSWORD=change-me-demo-12

# Phase 4 (KI) – serverseitig, niemals NEXT_PUBLIC_
ANTHROPIC_API_KEY=
# Optional: anderes Claude-Modell (Standard: claude-opus-5-5)
AI_MODEL=
