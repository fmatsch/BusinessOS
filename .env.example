# Kopieren nach .env und Werte setzen. .env wird nie committet.
POSTGRES_USER=businessos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=businessos
DATABASE_URL="postgresql://businessos:change-me@localhost:5432/businessos?schema=public"

# Erzeugen mit: npx auth secret   (oder: openssl rand -base64 32)
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Nur für lokales Seeding (synthetische Demo-Daten)
SEED_DEMO_PASSWORD=change-me-demo-12

# Optional: Basis-URL der Anwendung für Links in E-Mails (Passwort zurücksetzen), z. B. https://erp.firma.example
APP_URL=
# Optional: E-Mail-Versand für „Passwort vergessen“ (ohne diese Werte erzeugt der Inhaber einen Link), z. B. smtps://user:pass@mail.example:465
SMTP_URL=
MAIL_FROM=
# Optional: eigener Schlüssel (32 Byte, Base64 oder 64 Hex-Zeichen) für gespeicherte Zwei-Faktor-Geheimnisse; sonst aus AUTH_SECRET abgeleitet.
# Achtung: eine Änderung macht gespeicherte Geheimnisse unlesbar (Zwei-Faktor muss neu eingerichtet werden).
MFA_ENCRYPTION_KEY=

# Phase 4 (KI) – serverseitig, niemals NEXT_PUBLIC_
ANTHROPIC_API_KEY=
# Optional: anderes Claude-Modell (Standard: claude-opus-5-5)
AI_MODEL=
